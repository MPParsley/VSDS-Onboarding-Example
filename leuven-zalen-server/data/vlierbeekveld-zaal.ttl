<https://www.leuven.be/vlierbeekveld-zaal#2026-01-12T10:00:00Z>
  a schema:Place , infrastructure:Infrastructuurobject ;
  dcterms:isVersionOf <https://www.leuven.be/vlierbeekveld-zaal> ;
